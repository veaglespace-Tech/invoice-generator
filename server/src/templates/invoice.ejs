<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Invoice <%= invoice.invoice_number %></title>
  <style>
    body { font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; color: #333; margin: 0; padding: 0; }
    .invoice-box { max-width: 800px; margin: auto; padding: 30px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.15); font-size: 14px; line-height: 24px; }
    .header { display: flex; justify-content: space-between; margin-bottom: 40px; }
    .org-details h1 { margin: 0; font-size: 24px; color: #333; }
    .invoice-details { text-align: right; }
    .invoice-details h2 { margin: 0; font-size: 28px; color: #000; text-transform: uppercase; }
    .addresses { display: flex; justify-content: space-between; margin-bottom: 40px; }
    .bill-to, .ship-to { width: 48%; }
    table { width: 100%; line-height: inherit; text-align: left; border-collapse: collapse; margin-bottom: 30px; }
    table th, table td { padding: 10px; border-bottom: 1px solid #ddd; }
    table th { background: #f8f8f8; font-weight: bold; }
    .totals { width: 50%; float: right; }
    .totals table th, .totals table td { border: none; padding: 5px 10px; }
    .totals table tr.grand-total { font-weight: bold; font-size: 16px; border-top: 2px solid #333; }
    .clearfix { clear: both; }
    .footer { margin-top: 50px; font-size: 12px; color: #777; text-align: center; border-top: 1px solid #ddd; padding-top: 20px; }
  </style>
</head>
<body>
  <div class="invoice-box">
    <div class="header">
      <div class="org-details">
        <h1><%= invoice.organization.name %></h1>
        <% if (invoice.organization.address) { %><p><%= invoice.organization.address %></p><% } %>
        <% if (invoice.organization.email) { %><p>Email: <%= invoice.organization.email %></p><% } %>
        <% if (invoice.organization.GSTIN) { %><p>GSTIN: <%= invoice.organization.GSTIN %></p><% } %>
      </div>
      <div class="invoice-details">
        <h2>Invoice</h2>
        <p><strong>Invoice #:</strong> <%= invoice.invoice_number %></p>
        <p><strong>Date:</strong> <%= new Date(invoice.invoice_date).toLocaleDateString() %></p>
        <p><strong>Due Date:</strong> <%= new Date(invoice.due_date).toLocaleDateString() %></p>
      </div>
    </div>
    
    <div class="addresses">
      <div class="bill-to">
        <h3>Bill To:</h3>
        <p>
          <strong><%= invoice.customer.customer_name %></strong><br>
          <% if (invoice.customer.company_name) { %><%= invoice.customer.company_name %><br><% } %>
          <% if (invoice.customer.billing_address) { %><%= invoice.customer.billing_address %><br><% } %>
          <% if (invoice.customer.GSTIN) { %>GSTIN: <%= invoice.customer.GSTIN %><br><% } %>
        </p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th style="text-align: right;">Qty</th>
          <th style="text-align: right;">Rate</th>
          <th style="text-align: right;">Disc</th>
          <th style="text-align: right;">Tax</th>
          <th style="text-align: right;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% invoice.items.forEach(function(item) { %>
        <tr>
          <td><%= item.description %></td>
          <td style="text-align: right;"><%= item.quantity %></td>
          <td style="text-align: right;"><%= item.rate %></td>
          <td style="text-align: right;"><%= item.discount %></td>
          <td style="text-align: right;"><%= item.tax_amount %></td>
          <td style="text-align: right;"><%= item.amount %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="totals">
      <table>
        <tr>
          <td>Subtotal:</td>
          <td style="text-align: right;"><%= invoice.subtotal %></td>
        </tr>
        <% if (invoice.discount > 0) { %>
        <tr>
          <td>Discount:</td>
          <td style="text-align: right;"><%= invoice.discount %></td>
        </tr>
        <% } %>
        <tr>
          <td>Taxable Amount:</td>
          <td style="text-align: right;"><%= invoice.taxable_amount %></td>
        </tr>
        <% if (invoice.CGST > 0) { %>
        <tr>
          <td>CGST:</td>
          <td style="text-align: right;"><%= invoice.CGST %></td>
        </tr>
        <tr>
          <td>SGST:</td>
          <td style="text-align: right;"><%= invoice.SGST %></td>
        </tr>
        <% } %>
        <% if (invoice.IGST > 0) { %>
        <tr>
          <td>IGST:</td>
          <td style="text-align: right;"><%= invoice.IGST %></td>
        </tr>
        <% } %>
        <% if (invoice.round_off !== 0) { %>
        <tr>
          <td>Round Off:</td>
          <td style="text-align: right;"><%= invoice.round_off %></td>
        </tr>
        <% } %>
        <tr class="grand-total">
          <td>Grand Total:</td>
          <td style="text-align: right;"><%= invoice.grand_total %></td>
        </tr>
      </table>
    </div>
    <div class="clearfix"></div>

    <% if (invoice.notes) { %>
    <div style="margin-top: 30px;">
      <strong>Notes:</strong><br>
      <p><%= invoice.notes %></p>
    </div>
    <% } %>

    <% if (invoice.terms) { %>
    <div style="margin-top: 20px;">
      <strong>Terms & Conditions:</strong><br>
      <p><%= invoice.terms %></p>
    </div>
    <% } %>

    <div class="footer">
      <%= invoice.organization.settings?.invoice_footer || 'Thank you for your business!' %>
    </div>
  </div>
</body>
</html>
